# Protección adicional para el panel administrativo

# Proteger archivos sensibles
<FilesMatch "\.(sql|log|md|txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevenir listado de directorios
Options -Indexes

# Headers de seguridad adicionales para admin
<IfModule mod_headers.c>
    # Protección adicional contra clickjacking en admin
    Header always set X-Frame-Options "DENY"

    # Política de contenido más estricta
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Deshabilitar acceso directo a archivos de configuración
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

# Rate limiting básico (si el servidor lo soporta)
# Esto debe configurarse a nivel de servidor en Hostinger
