---
import '../styles/global.css';
import '../styles/components/buttons.css';
import '../styles/components/badges.css';
import { WHATSAPP_NUMBER, whatsappMessages } from '../data/categorias';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'product';
  canonicalUrl?: string;
}

const {
  title,
  description = 'Calzado femenino seleccionado con amor y calidad. Asesoría personalizada por WhatsApp desde Cali.',
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  canonicalUrl,
} = Astro.props;

const siteUrl = 'https://www.malejacalzado.com';
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;
const fullTitle = title.includes('MALEJA') ? title : `${title} | MALEJA Calzado`;
const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(whatsappMessages.catalogo)}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#C4637A" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MALEJA Calzado" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="site-header__brand" aria-label="Inicio MALEJA Calzado">
          <img src="/images/logos/logo.svg" alt="MALEJA Calzado" width="148" height="52" />
        </a>
        <nav class="site-nav" aria-label="Navegación principal">
          <a href="/">Inicio</a>
          <a href="/productos">Productos</a>
          <a href="/nosotras">Nosotras</a>
          <a href="/contacto">Contacto</a>
        </nav>
        <a class="btn btn--primary site-header__cta" href={whatsappUrl} target="_blank" rel="noopener">
          WhatsApp
        </a>
      </div>
    </header>
    <slot />
    <a class="whatsapp-float" href={whatsappUrl} target="_blank" rel="noopener" aria-label="Contactar por WhatsApp">
      <img class="icon icon--current" src="/icons/whatsapp-icon.svg" alt="" width="24" height="24" />
    </a>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <img src="/images/logos/logo.svg" alt="MALEJA Calzado" width="180" height="64" />
          <p>Selecciono calzado femenino con amor, calidad y flow caleño.</p>
        </div>
        <div class="site-footer__links">
          <a href="mailto:ventas@malejacalzado.com">
            <img class="icon" src="/icons/mail-icon.svg" alt="" width="18" height="18" />
            ventas@malejacalzado.com
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener">
            <img class="icon icon--current" src="/icons/whatsapp-icon.svg" alt="" width="18" height="18" />
            +57 317 270 3742
          </a>
          <a href="https://www.instagram.com/malejacalzado/" target="_blank" rel="noopener">
            <img class="icon" src="/icons/instagram-icon.svg" alt="" width="18" height="18" />
            Instagram
          </a>
          <a href="https://www.facebook.com/people/Maleja-Calzado/61578936597273/" target="_blank" rel="noopener">
            <img class="icon" src="/icons/facebook-icon.svg" alt="" width="18" height="18" />
            Facebook
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
