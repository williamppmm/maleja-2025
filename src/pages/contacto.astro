---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_NUMBER, whatsappMessages } from '../data/categorias';

const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(whatsappMessages.contacto)}`;
const faq = [
  {
    q: '¿Manejan todas las tallas?',
    a: 'Sí, manejamos desde la talla 35 hasta la 40, y en algunos modelos hasta la 41. Si tienes una talla especial, consúltanos y buscamos opciones.',
  },
  {
    q: '¿Cómo sé si la talla me queda?',
    a: 'Te ayudo con una guía de tallas personalizada. Si es tu primera compra, podemos coordinar una entrega personal para asegurar el ajuste perfecto.',
  },
  {
    q: '¿Los productos tienen garantía?',
    a: 'Todos nuestros productos tienen garantía de calidad. Si hay algún defecto de fabricación, lo solucionamos de inmediato.',
  },
  {
    q: '¿Qué métodos de pago aceptan?',
    a: 'Aceptamos efectivo, transferencias bancarias y pagos por apps móviles. Para clientas nuevas, preferimos contraentrega para mayor confianza.',
  },
  {
    q: '¿Hacen entregas a domicilio?',
    a: 'Sí, coordinamos entregas en Cali. Para clientas conocidas a veces hago entregas personales. ¡Me encanta conocer a quienes confían en MALEJA!',
  },
  {
    q: '¿Con qué frecuencia llegan modelos nuevos?',
    a: 'Constantemente. Como selecciono de las últimas colecciones, siempre hay novedades. Síguenos en redes para no perderte nada.',
  },
];
---

<Layout
  title="Contacto | MALEJA Calzado"
  description="Contacta a MALEJA Calzado por WhatsApp para asesoría personalizada en calzado femenino. Tallas, precios y entregas en Cali."
>
  <main id="main-content">

    <!-- Hero -->
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Contacto</p>
        <h1>¡Conversemos sobre tu estilo!</h1>
        <p>
          María Alejandra está lista para asesorarte y ayudarte a encontrar ese calzado
          perfecto que va con tu personalidad.
        </p>
        <div class="hero-home__actions" style="margin-top: var(--space-8);">
          <a class="btn btn--whatsapp btn--lg" href={whatsappUrl} target="_blank" rel="noopener">
            Chatear por WhatsApp
          </a>
          <a class="btn btn--outline btn--lg" href="mailto:ventas@malejacalzado.com">
            Enviar correo
          </a>
        </div>
      </div>
    </section>

    <!-- Métodos de contacto -->
    <section class="section">
      <div class="container">
        <div class="section__header">
          <p class="eyebrow">Canales</p>
          <h2>¿Cómo prefieres que hablemos?</h2>
        </div>
        <div class="contact-methods">

          <div class="contact-card contact-card--featured">
            <div class="contact-card__icon">
              <img class="icon icon--current" src="/icons/whatsapp-icon.svg" alt="" width="36" height="36" />
            </div>
            <h3>WhatsApp</h3>
            <p class="contact-card__tag">La forma más rápida</p>
            <p>
              Chateamos en tiempo real, te mando fotos de los modelos, resolvemos dudas
              al instante y coordinamos tu pedido.
            </p>
            <div class="contact-card__info">
              <strong>+57 317 270 3742</strong>
              <span>8:00 AM – 6:00 PM · Respondo rápido, incluso fuera de horario</span>
            </div>
            <a class="btn btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener">
              Iniciar chat
            </a>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon">
              <img class="icon" src="/icons/mail-icon.svg" alt="" width="36" height="36" />
            </div>
            <h3>Correo electrónico</h3>
            <p class="contact-card__tag">Para consultas detalladas</p>
            <p>
              Ideal para enviar referencias específicas, consultas sobre múltiples
              productos o cualquier duda especial.
            </p>
            <div class="contact-card__info">
              <strong>ventas@malejacalzado.com</strong>
              <span>Respuesta en 24 horas</span>
            </div>
            <a class="btn btn--outline" href="mailto:ventas@malejacalzado.com?subject=Consulta%20sobre%20productos">
              Enviar correo
            </a>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon">
              <img src="/icons/instagram.png" alt="" width="36" height="36" />
            </div>
            <h3>Redes sociales</h3>
            <p class="contact-card__tag">Síguenos y mantente al día</p>
            <p>
              Ve las últimas novedades, outfits de temporada y entérate de las nuevas
              colecciones que llegan.
            </p>
            <div class="contact-card__social">
              <a href="https://www.instagram.com/malejacalzado/" target="_blank" rel="noopener" class="social-link">
                <img src="/icons/instagram.png" alt="" width="18" height="18" />
                @malejacalzado
              </a>
              <a href="https://www.facebook.com/people/Maleja-Calzado/61578936597273/" target="_blank" rel="noopener" class="social-link">
                <img src="/icons/facebook.png" alt="" width="18" height="18" />
                Maleja Calzado
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Proceso de compra -->
    <section class="section section--alt">
      <div class="container">
        <div class="section__header">
          <p class="eyebrow">Así funciona</p>
          <h2>Proceso de compra</h2>
          <p>Simple, seguro y personalizado.</p>
        </div>
        <div class="steps">
          <div class="step">
            <div class="step__number">1</div>
            <div class="step__content">
              <h3>Conversamos</h3>
              <p>Me cuentas qué buscas, tu talla, ocasión de uso y estilo. ¡Me encanta conocer a mis clientas!</p>
            </div>
          </div>
          <div class="step">
            <div class="step__number">2</div>
            <div class="step__content">
              <h3>Te asesoro</h3>
              <p>Te muestro opciones perfectas para ti con fotos reales, precios, materiales y disponibilidad.</p>
            </div>
          </div>
          <div class="step">
            <div class="step__number">3</div>
            <div class="step__content">
              <h3>Coordinas tu pedido</h3>
              <p>Apartamos tu par favorito y coordinamos la entrega. Para clientas nuevas: contraentrega segura.</p>
            </div>
          </div>
          <div class="step">
            <div class="step__number">4</div>
            <div class="step__content">
              <h3>¡Disfrutas tu estilo!</h3>
              <p>Recibes tu calzado y te sientes increíble. Siempre estoy aquí para cualquier duda posterior.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="container">
        <div class="section__header">
          <p class="eyebrow">FAQ</p>
          <h2>Preguntas frecuentes</h2>
        </div>
        <div class="faq-grid">
          {faq.map(({ q, a }) => (
            <div class="faq-item">
              <h3>{q}</h3>
              <p>{a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section class="section section--alt">
      <div class="container cta-final">
        <h2>¿Lista para encontrar tu calzado perfecto?</h2>
        <p>No esperes más. Escríbeme y empecemos a buscar juntas ese par que va a enamorarte.</p>
        <div class="hero-home__actions" style="justify-content: center;">
          <a class="btn btn--primary btn--lg" href={whatsappUrl} target="_blank" rel="noopener">
            ¡Hablemos por WhatsApp!
          </a>
          <a class="btn btn--outline btn--lg" href="/productos">
            Ver catálogo
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>
